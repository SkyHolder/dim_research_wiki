  <tr><td>Живая ткань</td><td><span class="tag tag-blue">Rare</span></td><td>55¢</td><td>40¢</td></tr>
  <tr><td rowspan="3">MECHANICAL</td><td>Ржавая шестерня</td><td><span class="tag tag-gray">Common</span></td><td>8¢</td><td>5¢</td></tr>
  <tr><td>Инопланетный металл</td><td><span class="tag tag-green">Uncommon</span></td><td>15¢</td><td>10¢</td></tr>
  <tr><td>Древний компонент</td><td><span class="tag tag-blue">Rare</span></td><td>60¢</td><td>45¢</td></tr>
  <tr><td rowspan="2">CRYSTAL</td><td>Кристалл</td><td><span class="tag tag-blue">Rare</span></td><td>35¢</td><td>25¢</td></tr>
  <tr><td>Логический фрагмент</td><td><span class="tag tag-blue">Rare</span></td><td>70¢</td><td>50¢</td></tr>
  <tr><td>CHAOS</td><td>Образец мутагена</td><td><span class="tag tag-blue">Rare</span></td><td>80¢</td><td>60¢</td></tr>
</table>

<h3>Ресурсы по зондам (что выпадает)</h3>
<div class="card">
  <h4>Фильтрация при генерации лута</h4>
  <p>Ресурс выпадает с портала если:</p>
  <ul style="margin:8px 0 8px 20px">
    <li><code>item.dimension_type == portal.dimension_type</code> — ресурс привязан к этому измерению</li>
    <li><code>item.dimension_type == -1 (ANY)</code> — универсальный ресурс (пока таких нет)</li>
    <li><code>item.rarity ≤ probe.max_rarity</code> — редкость не выше максимума зонда</li>
  </ul>
  <p>Если ни один ресурс не подходит — fallback: все ресурсы с rarity ≤ max_rarity (без фильтра по измерению).</p>
</div>

<!-- ==================== RESEARCH ==================== -->
<h2 id="research">🔬 Древо исследований</h2>

<h3>CORE (База)</h3>
<table>
  <tr><th>Исследование</th><th>RP</th><th>Зависимости</th><th>Ресурсы</th><th>Эффект</th></tr>
  <tr><td>Базовый анализ</td><td>5</td><td>—</td><td>—</td><td>Разблокирует цепочку добычи и исследований</td></tr>
  <tr><td>Эффективная добыча</td><td>15</td><td>Базовый анализ</td><td>void_dust×2</td><td>+30% к добыче ресурсов</td></tr>
  <tr><td>Продвинутая добыча</td><td>30</td><td>Эффективная добыча</td><td>thermal_core×1 + pressure_pearl×1</td><td>+50% к добыче, анализатор</td></tr>
  <tr><td>Эффективный рынок</td><td>10</td><td>Базовый анализ</td><td>—</td><td>+20% к ценам продажи</td></tr>
  <tr><td>Инвентарь I</td><td>10</td><td>Базовый анализ</td><td>void_dust×1</td><td>30 слотов</td></tr>
  <tr><td>Инвентарь II</td><td>20</td><td>Инвентарь I</td><td>deep_salt×2 + ember_stone×2</td><td>40 слотов</td></tr>
  <tr><td>Инвентарь III</td><td>35</td><td>Инвентарь II</td><td>dense_ore×3 + thermal_core×2</td><td>60 слотов</td></tr>
  <tr><td>Void инвентарь</td><td>50</td><td>Инвентарь III</td><td>null_crystal×2 + echo_fragment×2</td><td>Бесконечное хранилище</td></tr>
  <tr style="background:rgba(90,106,224,0.1)"><td>🔹 Расширение порталов</td><td>15</td><td>Базовый анализ</td><td>void_dust×3</td><td>Максимум порталов +10</td></tr>
</table>

