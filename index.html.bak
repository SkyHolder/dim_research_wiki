  <tr><td>Железный корень</td><td><span class="tag tag-green">Uncommon</span></td><td>12¢</td><td>8¢</td></tr>
  <tr><td>Плотная руда</td><td><span class="tag tag-blue">Rare</span></td><td>25¢</td><td>18¢</td></tr>
  <tr><td rowspan="3">FIRE</td><td>Угольный камень</td><td><span class="tag tag-gray">Common</span></td><td>8¢</td><td>5¢</td></tr>
  <tr><td>Термоядро</td><td><span class="tag tag-green">Uncommon</span></td><td>15¢</td><td>10¢</td></tr>
  <tr><td>Магмовый кристалл</td><td><span class="tag tag-blue">Rare</span></td><td>40¢</td><td>28¢</td></tr>
  <tr><td rowspan="3">WATER</td><td>Глубинная соль</td><td><span class="tag tag-gray">Common</span></td><td>8¢</td><td>5¢</td></tr>
  <tr><td>Аква-гель</td><td><span class="tag tag-green">Uncommon</span></td><td>18¢</td><td>12¢</td></tr>
