  <tr><td rowspan="3">AIR</td><td>Сконденсированный газ</td><td><span class="tag tag-gray">Common</span></td><td>8¢</td><td>5¢</td></tr>
  <tr><td>Ионная пыль</td><td><span class="tag tag-green">Uncommon</span></td><td>15¢</td><td>10¢</td></tr>
  <tr><td>Небесное ядро</td><td><span class="tag tag-blue">Rare</span></td><td>50¢</td><td>38¢</td></tr>
