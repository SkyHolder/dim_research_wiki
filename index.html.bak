<!-- ==================== DATA FLOW ==================== -->
<h2 id="data-flow">🔄 Потоки данных</h2>

<h3>Зондирование портала — поток</h3>
<div class="flow">
  <span class="flow-item">Клик «Зонд»</span>
  <span class="flow-arrow">→</span>
  <span class="flow-item">PortalModal._send_probe()</span>
  <span class="flow-arrow">→</span>
  <span class="flow-item">InteractionSystem._probe_portal()</span>
  <span class="flow-arrow">→</span>
  <span class="flow-item" style="border-color:var(--green)">✓ Проверка сложности</span>
  <span class="flow-arrow">→</span>
  <span class="flow-item" style="border-color:var(--green)">✓ Проверка выживаемости</span>
  <span class="flow-arrow">→</span>
  <span class="flow-item">Расчёт данных</span>
  <span class="flow-arrow">→</span>
  <span class="flow-item">Генерация ресурсов</span>
  <span class="flow-arrow">→</span>
  <span class="flow-item">Обновление knowledge_level</span>
  <span class="flow-arrow">→</span>
  <span class="flow-item">Проверка нестабильности</span>
</div>

<h3>Разблокировка зонда — поток</h3>
<div class="flow">
  <span class="flow-item">ResearchManager.research_node()</span>
  <span class="flow-arrow">→</span>
  <span class="flow-item">Проверка RP + ресурсы</span>
  <span class="flow-arrow">→</span>
  <span class="flow-item">Списание</span>
  <span class="flow-arrow">→</span>
  <span class="flow-item">node.researched = true</span>
  <span class="flow-arrow">→</span>
  <span class="flow-item">unlocks_items → MarketManager.on_equipment_unlocked()</span>
  <span class="flow-arrow">→</span>
  <span class="flow-item">Заполнение stock до cap</span>
</div>

<h3>События — поток</h3>
<div class="flow">
  <span class="flow-item">EventBus.emit("show_notification")</span>
  <span class="flow-arrow">→</span>
  <span class="flow-item">EventLog._insert()</span>
  <span class="flow-arrow">→</span>
  <span class="flow-item">entry_added.emit()</span>
  <span class="flow-arrow">→</span>
  <span class="flow-item">MessageFeed._refresh_from_log()</span>
</div>
<div class="flow" style="margin-top:4px">
  <span class="flow-item">EventBus.emit("portal_spawned")</span>
  <span class="flow-arrow">→</span>
  <span class="flow-item">EventLog._on_portal_spawned()</span>
  <span class="flow-arrow">→</span>
  <span class="flow-item">add_portal_entry() + callback</span>
  <span class="flow-arrow">→</span>
  <span class="flow-item">entry_added.emit()</span>
  <span class="flow-arrow">→</span>
  <span class="flow-item">MessageFeed обновляется</span>
</div>

<h3>Autoloads (синглтоны)</h3>
<table>
  <tr><th>Autoload</th><th>Группа</th><th>Ответственность</th></tr>
  <tr><td>EventBus</td><td>event_bus</td><td>Глобальная шина сигналов</td></tr>
  <tr><td>GameManager</td><td>—</td><td>Кредиты, RP, фаза игры</td></tr>
  <tr><td>DataRegistry</td><td>—</td><td>Реестр .tres ресурсов/порталов/зданий</td></tr>
  <tr><td>ResearchManager</td><td>—</td><td>Древо исследований, разблокировки</td></tr>
  <tr><td>MarketManager</td><td>—</td><td>Цены, запасы, покупка/продажа</td></tr>
  <tr><td>QuestManager</td><td>—</td><td>Система заданий</td></tr>
  <tr><td>DebugLogger</td><td>—</td><td>Отладочное логирование</td></tr>
  <tr><td>EventLog</td><td>event_log</td><td>Журнал событий с коллбэками</td></tr>
  <tr><td>JournalManager</td><td>—</td><td>Фрагменты знаний</td></tr>
</table>

